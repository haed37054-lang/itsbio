        "documentsHtml": "<div>\n    <div class=\"abm-doc-div\">\n        <div class=\"abm-doc-title\">\n            Search CoA <a href=\"https://www.abmgood.com/CoA-Library.html\" class=\"abm-link\" target=\"_blank\" rel=\"noopener noreferrer\">here</a>\n        </div>\n    </div>\n        \n            <div class=\"abm-doc-div\">\n            <div class=\"abm-doc-title\">MSDS</div>\n            <ul class=\"abm-document-list\">\n                                                            <li>\n                            <a href=\"https://www.abmgood.com/uploads/document/Vector_Plasmid_MSDS.pdf\" target=\"_blank\" rel=\"noopener noreferrer\">Plasmid MSDS</a>\n                        </li>\n                                                </ul>\n        </div>\n                            <div class=\"abm-doc-div\">\n            <div class=\"abm-doc-title\">Supporting Protocol</div>\n            <ul class=\"abm-document-list\">\n                                                            <li>\n                            <a href=\"https://www.abmgood.com/uploads/document/Plasmid%20Amplification%20Protocol%202026.pdf\" target=\"_blank\" rel=\"noopener noreferrer\">Plasmid Amplification Protocol</a>\n                        </li>\n                                                </ul>\n        </div>\n                    </div>",
        "documents": [],
